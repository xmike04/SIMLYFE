# Copy to .env.local and fill in real values (see docs/agent-guide.md → Environment variables).
# Firebase web config is public client config — get values with:
#   npx -y firebase-tools@latest apps:sdkconfig WEB --project symlife-cd0b6

# Supabase event proxy
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE=

# Firebase (all six required to activate cloud saves + authenticated AI events)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: App Check (reCAPTCHA v3 site key; debug token for local dev)
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Optional: debug tools sheet
VITE_ENABLE_DEV_TOOLS=false
