# LLM proxy for production-safe AI events
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local-only direct OpenAI fallback. Do not set this in production builds.
VITE_OPENAI_API_KEY=

# Optional Firebase cloud saves. All six values are required to enable saves.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional local/debug tools. Omit or set false for portfolio/production demos.
VITE_ENABLE_DEV_TOOLS=false

# Vercel CLI/CI metadata. Values are stored locally in .vercel/project.json
# after `vercel link`; commit neither .vercel nor real secrets.
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
