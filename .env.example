# Browser-visible Vite configuration. Never put an OpenAI key in a VITE_* variable.
VITE_SUPABASE_URL=
# Preferred for current Supabase projects.
VITE_SUPABASE_PUBLISHABLE=
# Legacy projects may use the anon key instead.
VITE_SUPABASE_ANON_KEY=

# Firebase Authentication and Firestore. All six values are required for
# authenticated AI events and cloud saves.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional local/debug tools. Keep false for portfolio and production builds.
VITE_ENABLE_DEV_TOOLS=false

# Optional Vercel CLI/CI metadata. `vercel link` stores real values in the
# ignored .vercel directory; do not commit credentials.
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
