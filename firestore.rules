rules_version = '2';

// Least-privilege Firestore rules for SIMLYFE cloud saves.
//
// Deploys on matching main-branch changes when the GitHub service-account
// secret is configured. Manual deployment: `firebase deploy --only firestore:rules`.
//
// Client access (src/engine/cloud/useCloudAccount.js) is limited to:
//   users/{uid}/saves/currentLife — the player's single life save
//   careers                       — read-only catalog, seeded by
//                                   scripts/migrateData.js via the Admin SDK
//                                   (which bypasses these rules)
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Post-write document may only contain known save fields: LIFE_SAVE_KEYS
    // (src/engine/lifeSave.js) plus legacy fields tolerated by validateHydratedSave
    // (stateValidation.js KNOWN_SAVE_FIELDS). Merge writes see the merged
    // result, so a legacy doc with a rogue field is rejected until a life
    // boundary (death/reset/new life) full-replaces it with a clean payload.
    // src/tests/firestoreRules.test.js fails if this list drifts from the app.
    function isKnownSaveShape() {
      return request.resource.data.keys().hasOnly([
        'character', 'age', 'stats', 'bank', 'history', 'isDead', 'flags',
        'career', 'careerMeta', 'relationships', 'belongings', 'properties',
        'education', 'networking', 'economyCycle', 'pets', 'will',
        'currentEvent', 'activitiesThisYear', 'narrativeMode', 'schemaVersion'
      ]);
    }

    match /users/{userId}/saves/currentLife {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isKnownSaveShape();
      // No delete: the app replaces the save on reset, never deletes it.
    }

    match /careers/{careerId} {
      allow read: if request.auth != null;
      // No client writes: seeding uses the Admin SDK.
    }

    // Immutable, owner-scoped support inbox. Only the Admin SDK/operator can
    // list, process or delete requests; clients cannot change their status.
    match /users/{userId}/supportRequests/{requestId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['kind', 'reason', 'requestId', 'description', 'choiceTexts', 'createdAt'])
        && request.resource.data.keys().hasOnly(['kind', 'reason', 'requestId', 'description', 'choiceTexts', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 4096
        && request.resource.data.choiceTexts is list
        && request.resource.data.choiceTexts.size() <= 3
        && (request.resource.data.choiceTexts.size() < 1 || (request.resource.data.choiceTexts[0] is string && request.resource.data.choiceTexts[0].size() <= 300))
        && (request.resource.data.choiceTexts.size() < 2 || (request.resource.data.choiceTexts[1] is string && request.resource.data.choiceTexts[1].size() <= 300))
        && (request.resource.data.choiceTexts.size() < 3 || (request.resource.data.choiceTexts[2] is string && request.resource.data.choiceTexts[2].size() <= 300))
        && request.resource.data.requestId is string
        && ((request.resource.data.kind == 'account_deletion'
          && requestId == 'account-deletion'
          && request.resource.data.reason == 'account_deletion'
          && request.resource.data.requestId == ''
          && request.resource.data.description == ''
          && request.resource.data.choiceTexts.size() == 0)
        || (request.resource.data.kind == 'content_report'
          && request.resource.data.reason in ['offensive', 'unsafe', 'other']
          && request.resource.data.requestId.matches('^[A-Za-z0-9_-]{1,128}$')
          && requestId == 'event-' + request.resource.data.requestId
          && request.resource.data.description.size() > 0));
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
